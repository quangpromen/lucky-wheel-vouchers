{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=<YOUR_SERVER>;Database=LuckyWheelDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "LuckyWheel.Api",
    "Audience": "LuckyWheel.Admin",
    "AccessTokenLifetimeMinutes": 30,
    "SigningKey": "<provide-via-user-secrets-or-environment>"
  },
  "BootstrapAdmin": {
    "Username": "<your-admin-email>",
    "Password": "<strong-password-via-user-secrets>",
    "DisplayName": "Administrator"
  },
  "PrizeKeyProtection": {
    "EncryptionKey": "<base64-encoded-32-byte-key-via-user-secrets>"
  }
}
